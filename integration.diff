+
+
+// ─────────────────────────────────────────────
+// SHOPPING AGENTS
+// A user's own agent: it searches and watches the marketplace inside the
+// user's rules and proposes matches; the user approves and pays from their
+// own wallet. Port66 never holds the user's money. Tables are additive
+// (migrations/manual/20261114_shopping_agents.sql) and are also created on
+// first use by the API.
+// ─────────────────────────────────────────────
+
+model ShoppingAgent {
+  id     String @id @default(cuid())
+  userId String
+  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
+
+  name           String
+  query          String
+  brandName      String?
+  size           String?
+  condition      String?
+  maxItemUsd     Decimal  @db.Decimal(12, 2)
+  dailyBudgetUsd Decimal  @db.Decimal(12, 2)
+  payWith        String[]
+  negotiate      Boolean  @default(false)
+  status         String   @default("ACTIVE") // ACTIVE | PAUSED
+  // Automatic buying: the agent pays from the user's own Coinbase Smart
+  // Wallet through a Base spend permission the user signed (daily cap
+  // enforced on chain), and ships to shipTo.
+  autoBuy         Boolean @default(false)
+  spendPermission Json?
+  buyerWallet     String?
+  shipTo          Json?
+  lastRunAt      DateTime?
+
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+
+  matches ShoppingAgentMatch[]
+  events  ShoppingAgentEvent[]
+
+  @@index([userId])
+  @@index([status])
+}
+
+model ShoppingAgentMatch {
+  id      String        @id @default(cuid())
+  agentId String
+  agent   ShoppingAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
+
+  listingId String
+  priceUsd  Decimal @db.Decimal(12, 2)
+  // PENDING (awaiting the user) | OFFERED | BUYING (agent paid, settling)
+  // | DISMISSED | PURCHASED | FAILED | GONE
+  status     String  @default("PENDING")
+  reason     String
+  offerId    String?
+  checkoutId String?
+  payTx      String?
+
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+
+  @@unique([agentId, listingId])
+  @@index([status])
+}
+
+model ShoppingAgentEvent {
+  id      String        @id @default(cuid())
+  agentId String
+  agent   ShoppingAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
+
+  kind    String // RUN | MATCH | SKIP | OFFER | PURCHASED | GONE | PAUSED | RESUMED
+  message String
+  data    Json?
+
+  createdAt DateTime @default(now())
+
+  @@index([agentId, createdAt])
+}
